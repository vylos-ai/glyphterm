{
  "name": "glyphterm",
  "version": "0.1.0",
  "description": "3D models and a live avatar for your coding agent, drawn with text in the terminal. Built on glyphcss.",
  "keywords": [
    "terminal",
    "3d",
    "ascii",
    "ansi",
    "tui",
    "glyphcss",
    "claude-code",
    "ai-agent",
    "avatar",
    "cli"
  ],
  "homepage": "https://github.com/vylos-ai/glyphterm#readme",
  "bugs": {
    "url": "https://github.com/vylos-ai/glyphterm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vylos-ai/glyphterm.git"
  },
  "license": "MIT",
  "author": "Vylos AI",
  "type": "module",
  "bin": {
    "glyphterm": "bin/glyphterm.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "skills/",
    "examples/*.obj",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/glyphterm.js",
    "demo": "node bin/glyphterm.js torus --style halfblock",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "schema": "node scripts/scene-schema.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@glyphcss/core": "^0.3.1",
    "glyphcss": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
